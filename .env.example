# Ejemplo de configuración de entorno para NovaSoft

# Base de datos
DB_HOST=localhost
DB_NAME=novasoft_db
DB_USER=root
DB_PASS=
DB_PORT=3306

# Configuración de la aplicación
APP_ENV=development
APP_URL=http://localhost/NovaSoft

# Configuración de correo (si usas notificaciones)
MAIL_HOST=smtp.tuservidor.com
MAIL_PORT=587
MAIL_USER=usuario@tuservidor.com
MAIL_PASS=contraseña
MAIL_FROM=notificaciones@novasoft.com
MAIL_FROM_NAME=NovaSoft
